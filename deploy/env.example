# Copy this file to .env in the folder of compose.yml.

# The image to run. The deployment script pins a version here.
STUDIO_SERVER_IMAGE=ghcr.io/inthemorning/studio-server:latest

# The origin that the users open. It must be https.
# The nginx Host header must be the host of this origin.
STUDIO_PUBLIC_ORIGIN=https://studio.musicindex.org
